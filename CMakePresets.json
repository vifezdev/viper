{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "x64-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "17",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "x64-Debug",
            "displayName": "x64 Debug",
            "description": "MSVC x64 Debug build with Ninja",
            "inherits": "x64-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "x64-Release",
            "displayName": "x64 Release",
            "description": "MSVC x64 Release build with Ninja",
            "inherits": "x64-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "x64-Debug",
            "displayName": "Build x64 Debug",
            "configurePreset": "x64-Debug"
        },
        {
            "name": "x64-Release",
            "displayName": "Build x64 Release",
            "configurePreset": "x64-Release"
        }
    ]
}
